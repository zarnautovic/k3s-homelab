k8sServiceHost: {{ hostvars[groups['cp'][0]].ansible_host }}
k8sServicePort: 6443

kubeProxyReplacement: true

k8sClientRateLimit:
  qps: 50
  burst: 100

ipam:
  mode: "cluster-pool"
  operator:
    clusterPoolIPv4PodCIDRList:
      - "{{ cilium_cluster_pod_cidr }}"
    clusterPoolIPv4MaskSize: 24

routingMode: "native"

ipv4NativeRoutingCIDR: "{{ cilium_cluster_pod_cidr }}"

devices:
  - "{{ cilium_iface }}"

hubble:
  enabled: false

l2announcements:
  enabled: true

externalIPs:
  enabled: true

loadBalancer:
  enabled: true

bpf:
  masquerade: true

daemon:
  enableSourceIPVerification: false

autoDirectNodeRoutes: true

